
pipeline {
    agent any

    tools {
        jdk 'JDK17'
        maven 'Maven3'
        nodejs 'NodeJS22'
    }

    triggers {
        cron('TZ=Asia/Kolkata\n30 12 * * *')
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        APP_REPO = 'https://github.com/Meganartech/InvoiceBill.git'
        GITHUB_CREDENTIALS = 'github-credentials'
        APP_BRANCH = 'v2'

        DEPLOY_DIR = 'D:\\DevOps-Testing-Buildfiles\\v2'

        EMAIL_RECIPIENT = credentials('invoicebill-v2-email-recipient')
    }

    stages {

        stage('Checkout Application') {
            steps {
                echo "Checking out InvoiceBill branch: ${APP_BRANCH}"

                dir('Application') {
                    git branch: "${APP_BRANCH}",
                        credentialsId: "${GITHUB_CREDENTIALS}",
                        url: "${APP_REPO}"
                }
            }
        }

        stage('Prepare Environment File') {
            steps {
                dir('Application/InvoiceBill') {
                    script {
                        if (!fileExists('.env')) {
                            echo '.env file not found. Creating an empty .env file.'
                            writeFile file: '.env', text: ''
                        } else {
                            echo '.env file already exists.'
                        }
                    }
                }
            }
        }

        stage('Build Backend') {
            steps {
                dir('Application/InvoiceBill') {
                    echo 'Building Spring Boot Backend...'
                    bat 'mvn -B clean verify'
                }
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                dir('Application/invoiceBillFrontend') {
                    echo 'Installing React Frontend Dependencies...'
                    bat 'npm ci'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('Application/invoiceBillFrontend') {
                    echo 'Building React Frontend...'
                    bat 'set "CI=false" && npm run build'
                }
            }
        }

        stage('Archive Build Artifacts') {
            steps {
                archiveArtifacts artifacts:
                    'Application/InvoiceBill/target/*.war, Application/invoiceBillFrontend/build/**',
                    fingerprint: true
            }
        }

        stage('Deploy Application') {
            steps {
                script {
                    def warFile = findFiles(
                        glob: 'Application/InvoiceBill/target/*.war'
                    )

                    if (warFile.length == 0) {
                        error 'WAR file not found. Deployment cancelled.'
                    }

                    bat """
                        if not exist "${DEPLOY_DIR}" mkdir "${DEPLOY_DIR}"
                        if not exist "${DEPLOY_DIR}\\Frontend" mkdir "${DEPLOY_DIR}\\Frontend"
                    """

                    echo 'Deploying Backend WAR...'

                    bat """
                        copy /Y "${warFile[0].path}" "${DEPLOY_DIR}\\"
                    """

                    echo 'Deploying Frontend Build...'

                    bat """
                        robocopy "Application\\invoiceBillFrontend\\build" "${DEPLOY_DIR}\\Frontend" /E
                        if %ERRORLEVEL% GEQ 8 exit /b %ERRORLEVEL%
                        exit /b 0
                    """

                    echo "Deployment completed successfully: ${DEPLOY_DIR}"
                }
            }
        }
    }

    post {

        success {
            emailext(
                to: env.EMAIL_RECIPIENT,
                subject: "SUCCESS: InvoiceBill V2 Build #${BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h2 style="color:green;">InvoiceBill V2 Pipeline Successful</h2>

                    <p>Hello Team,</p>

                    <p>The InvoiceBill V2 pipeline completed successfully.</p>

                    <table border="1" cellpadding="8" cellspacing="0">
                        <tr>
                            <td><b>Project</b></td>
                            <td>InvoiceBill</td>
                        </tr>
                        <tr>
                            <td><b>Branch</b></td>
                            <td>${APP_BRANCH}</td>
                        </tr>
                        <tr>
                            <td><b>Build Number</b></td>
                            <td>${BUILD_NUMBER}</td>
                        </tr>
                        <tr>
                            <td><b>Build Status</b></td>
                            <td style="color:green;">SUCCESS</td>
                        </tr>
                        <tr>
                            <td><b>Deployment Folder</b></td>
                            <td>${DEPLOY_DIR}</td>
                        </tr>
                    </table>

                    <br>
                    <p>Regards,<br>Jenkins CI/CD Automation</p>
                """
            )
        }

        failure {
            emailext(
                to: env.EMAIL_RECIPIENT,
                subject: "FAILED: InvoiceBill V2 Build #${BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h2 style="color:red;">InvoiceBill V2 Pipeline Failed</h2>

                    <p>Hello Team,</p>

                    <p>The InvoiceBill V2 pipeline has failed.</p>

                    <table border="1" cellpadding="8" cellspacing="0">
                        <tr>
                            <td><b>Project</b></td>
                            <td>InvoiceBill</td>
                        </tr>
                        <tr>
                            <td><b>Branch</b></td>
                            <td>${APP_BRANCH}</td>
                        </tr>
                        <tr>
                            <td><b>Build Number</b></td>
                            <td>${BUILD_NUMBER}</td>
                        </tr>
                        <tr>
                            <td><b>Build Status</b></td>
                            <td style="color:red;">FAILED</td>
                        </tr>
                    </table>

                    <br>
                    <p>Please check the Jenkins console output for the error.</p>

                    <p>Regards,<br>Jenkins CI/CD Automation</p>
                """
            )
        }

        always {
            echo 'InvoiceBill V2 Pipeline execution completed.'
        }
    }
}
